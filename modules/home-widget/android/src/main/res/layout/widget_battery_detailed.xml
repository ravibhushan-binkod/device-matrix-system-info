<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/widget_card_light" />

  <ViewFlipper
      android:id="@+id/widget_motion"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateFirstView="false"
      android:autoStart="false"
      android:clickable="false"
      android:focusable="false"
      android:importantForAccessibility="no"
      android:inAnimation="@anim/widget_sheen_in"
      android:outAnimation="@anim/widget_sheen_out">

    <ImageView
        android:id="@+id/widget_sheen_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light" />

    <ImageView
        android:id="@+id/widget_sheen_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light_bright" />
  </ViewFlipper>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="14dp"
      android:paddingTop="10dp"
      android:paddingEnd="10dp"
      android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/widget_icon"
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="@string/widget_logo"
          android:scaleType="fitCenter"
          android:src="@drawable/widget_app_icon" />

      <TextView
          android:id="@+id/widget_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="9dp"
          android:layout_weight="1"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/widget_battery"
          android:textColor="#111827"
          android:textSize="15sp" />

      <TextView
          android:id="@+id/widget_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/widget_preview_battery_percent"
          android:textColor="#111827"
          android:textSize="20sp" />

      <TextView
          android:id="@+id/widget_percent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/widget_preview_battery_percent"
          android:textColor="#0E7490"
          android:textSize="15sp"
          android:visibility="gone" />

      <ImageView
          android:id="@+id/widget_refresh"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:layout_marginStart="6dp"
          android:contentDescription="@string/widget_refresh_all"
          android:padding="7dp"
          android:src="@drawable/ic_widget_refresh_light" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_preview_charge_status"
        android:textColor="#475569"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar_preview_battery" />
  </LinearLayout>
</FrameLayout>
