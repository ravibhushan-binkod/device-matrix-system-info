<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/widget_card_light" />

  <ViewFlipper
      android:id="@+id/widget_motion"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateFirstView="false"
      android:autoStart="false"
      android:clickable="false"
      android:focusable="false"
      android:importantForAccessibility="no"
      android:inAnimation="@anim/widget_sheen_in"
      android:outAnimation="@anim/widget_sheen_out">

    <ImageView
        android:id="@+id/widget_sheen_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light" />

    <ImageView
        android:id="@+id/widget_sheen_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light_bright" />
  </ViewFlipper>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="14dp"
      android:paddingTop="10dp"
      android:paddingEnd="10dp"
      android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/widget_icon"
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="@string/widget_logo"
          android:scaleType="fitCenter"
          android:src="@drawable/widget_app_icon" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="9dp"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_health_title"
            android:textColor="#111827"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_device_fallback"
            android:textColor="#475569"
            android:textSize="10sp" />
      </LinearLayout>

      <TextClock
          android:id="@+id/widget_clock"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="sans-serif-medium"
          android:format12Hour="h:mm a"
          android:format24Hour="HH:mm"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="#111827"
          android:textSize="20sp" />

      <ImageView
          android:id="@+id/widget_refresh"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:layout_marginStart="4dp"
          android:contentDescription="@string/widget_refresh_all"
          android:padding="7dp"
          android:src="@drawable/ic_widget_refresh_light" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <FrameLayout
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_health_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_health_ring_preview" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

          <TextView
              android:id="@+id/widget_health_value"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/widget_preview_health_score"
              android:textColor="#16A34A"
              android:textSize="32sp" />

          <TextView
              android:id="@+id/widget_health_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/widget_ring_health"
              android:textColor="#475569"
              android:textSize="10sp" />
        </LinearLayout>
      </FrameLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_health_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_health_caption"
            android:textColor="#475569"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_health_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_calculated_locally"
            android:textColor="#475569"
            android:textSize="9.5sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="bottom"
        android:orientation="horizontal">

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_ram_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_ram"
            android:textColor="#475569"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_ram_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_ram_percent"
            android:textColor="#111827"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_ram_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_health_ram_caption"
            android:textColor="#475569"
            android:textSize="8.5sp" />

        <ImageView
            android:id="@+id/widget_ram_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview_ram" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_storage_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_storage"
            android:textColor="#475569"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_storage_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_storage_percent"
            android:textColor="#111827"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_storage_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_health_storage_caption"
            android:textColor="#475569"
            android:textSize="8.5sp" />

        <ImageView
            android:id="@+id/widget_storage_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview_storage" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_battery_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_battery"
            android:textColor="#475569"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_battery_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_battery_percent"
            android:textColor="#111827"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_battery_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_health_battery_caption"
            android:textColor="#475569"
            android:textSize="8.5sp" />

        <ImageView
            android:id="@+id/widget_battery_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview_battery" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
