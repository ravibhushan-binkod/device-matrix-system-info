<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/widget_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/widget_card_light" />

  <ViewFlipper
      android:id="@+id/widget_motion"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateFirstView="false"
      android:autoStart="false"
      android:clickable="false"
      android:focusable="false"
      android:importantForAccessibility="no"
      android:inAnimation="@anim/widget_sheen_in"
      android:outAnimation="@anim/widget_sheen_out">

    <ImageView
        android:id="@+id/widget_sheen_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light" />

    <ImageView
        android:id="@+id/widget_sheen_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen_light_bright" />
  </ViewFlipper>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/widget_icon"
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:contentDescription="@string/widget_logo"
          android:scaleType="fitCenter"
          android:src="@drawable/widget_app_icon" />

      <TextView
          android:id="@+id/widget_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="9dp"
          android:layout_weight="1"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/widget_ram"
          android:textColor="#111827"
          android:textSize="15sp" />

      <ImageView
          android:id="@+id/widget_refresh"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:contentDescription="@string/widget_refresh_all"
          android:padding="7dp"
          android:src="@drawable/ic_widget_refresh_light" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

      <ImageView
          android:id="@+id/widget_ring"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitCenter"
          android:src="@drawable/widget_ring_preview_ram" />

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:gravity="center"
          android:orientation="vertical">

        <TextView
            android:id="@+id/widget_ring_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_ram_percent"
            android:textColor="#111827"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/widget_ring_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_ring_used"
            android:textColor="#475569"
            android:textSize="11sp" />
      </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_preview_ram_pair"
        android:textColor="#475569"
        android:textSize="11sp" />
  </LinearLayout>
</FrameLayout>
