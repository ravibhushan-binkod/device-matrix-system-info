<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:angle="270"
          android:endColor="#D9F4F8FC"
          android:startColor="#DEFFFFFF" />
      <corners android:radius="22dp" />
      <stroke
          android:width="1dp"
          android:color="#C7D5E2EE" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:angle="270"
          android:centerColor="#00FFFFFF"
          android:endColor="#00FFFFFF"
          android:startColor="#0A0F172A" />
      <corners android:radius="22dp" />
    </shape>
  </item>
</layer-list>
