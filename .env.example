# Device Matrix environment variables.
#
# There is no backend: this file only documents local build configuration.
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle —
# never put secrets here, and never commit a filled-in `.env`.
#
# AdMob (added with the ads phase): development always uses Google's official
# test ids. Production ids from the AdMob console belong in your local `.env`:
#EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
#EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
#EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
#EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID=
#EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
#
# Public support address shown in the Privacy policy and store listing.
# Replace the support@example.com placeholder before publishing.
#EXPO_PUBLIC_SUPPORT_EMAIL=
